---
import { CheckCircle2, ChevronLeft, ChevronRight } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const items = [
  {
    title: 'Coconut Charcoal Briquette',
    sub: '100% Natural Shisha & BBQ Charcoal',
    src: '/images/new_assets/burning-cube-briquettes.webp',
    alt: 'Burning Cube Charcoal Briquette'
  },
  {
    title: '5kg Low EC Cocopeat Block',
    sub: 'Washed Substrate (< 0.6 mS/cm)',
    src: '/images/new_assets/cocopeat-block.webp',
    alt: '5kg Low EC Cocopeat Block'
  },
  {
    title: 'Raw Coconut Fiber',
    sub: 'High-Lignin Natural Mattress Coir',
    src: '/images/new_assets/raw-coconut-fiber.webp',
    alt: 'Raw Coconut Fiber'
  },
  {
    title: 'Hexagon Charcoal Briquettes',
    sub: 'Extended Burning BBQ & Hookah Briquettes',
    src: '/images/new_assets/stacked-hexagon-briquettes.webp',
    alt: 'Stacked Hexagon Briquettes'
  },
  {
    title: 'Bulk Cocopeat Substrate',
    sub: 'Warehouse Storage & Palletized Export',
    src: '/images/new_assets/warehouse-cocopeat-blocks.webp',
    alt: 'Warehouse Cocopeat Blocks'
  }
];
---

<div class={`stacked-carousel-container relative w-full max-w-[540px] mx-auto group select-none ${className}`}>
  <!-- Outer Glow Backdrop -->
  <div class="absolute -inset-4 bg-gradient-to-r from-accent-gold/20 via-primary-green/20 to-accent-gold/20 rounded-3xl transform rotate-2 group-hover:rotate-4 transition-transform duration-700 blur-xl opacity-70"></div>

  <!-- Stack Container -->
  <div class="relative w-full aspect-[4/3] sm:aspect-[1/1] max-h-[480px]">
    {items.map((item, index) => (
      <div
        data-index={index}
        class="stacked-card absolute inset-0 w-full h-full rounded-3xl p-2 sm:p-3 bg-surface-dark/95 border border-accent-gold/20 shadow-2xl transition-all duration-700 ease-in-out cursor-pointer overflow-hidden"
      >
        <div class="relative w-full h-full rounded-2xl overflow-hidden bg-primary-charcoal">
          <img
            src={item.src}
            alt={item.alt}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
          />
          
          <!-- Top-Left Title Badge (Leaves bottom watermark 100% clear) -->
          <div class="absolute top-4 left-4 z-20 max-w-[80%] pointer-events-none">
            <span class="inline-block px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-primary-charcoal/90 backdrop-blur-md border border-accent-gold/40 text-accent-gold font-bold text-xs tracking-wider uppercase shadow-lg mb-1">
              {item.title}
            </span>
            <p class="text-xs sm:text-sm text-gray-200 font-medium truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">
              {item.sub}
            </p>
          </div>
        </div>
      </div>
    ))}

    <!-- Floating 100% Quality Badge (Positioned top-right outside stack to keep bottom watermark completely clear) -->
    <div class="absolute -top-5 -right-3 sm:-top-6 sm:-right-6 z-40 bg-surface-dark/95 backdrop-blur-md border border-accent-gold/30 p-3.5 sm:p-4 rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.8)] animate-bounce-slow">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 sm:w-11 sm:h-11 bg-gradient-gold text-primary-dark rounded-full flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(212,175,55,0.4)]">
          <CheckCircle2 class="text-primary-dark w-5 h-5 sm:w-6 sm:h-6" />
        </div>
        <div>
          <div class="text-lg sm:text-xl font-bold text-white">100%</div>
          <div class="text-xs text-gray-300 font-medium">Premium Quality</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Carousel Controls & Pagination Dots -->
  <div class="flex items-center justify-between mt-8 px-2 relative z-40">
    <div class="flex items-center gap-2 dots-container">
      {items.map((_, i) => (
        <button
          data-dot={i}
          aria-label={`Go to slide ${i + 1}`}
          class={`dot-btn w-2.5 h-2.5 rounded-full transition-all duration-300 ${
            i === 0 ? 'bg-accent-gold w-8 shadow-[0_0_10px_rgba(212,175,55,0.8)]' : 'bg-white/20 hover:bg-white/40'
          }`}
        ></button>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        class="prev-btn p-2 rounded-full bg-surface-dark/80 backdrop-blur-md border border-white/10 text-white hover:border-accent-gold hover:text-accent-gold transition-colors"
        aria-label="Previous image"
      >
        <ChevronLeft class="w-5 h-5" />
      </button>
      <button
        class="next-btn p-2 rounded-full bg-surface-dark/80 backdrop-blur-md border border-white/10 text-white hover:border-accent-gold hover:text-accent-gold transition-colors"
        aria-label="Next image"
      >
        <ChevronRight class="w-5 h-5" />
      </button>
    </div>
  </div>
</div>

<script>
  function initStackedCarousels() {
    const containers = document.querySelectorAll('.stacked-carousel-container');

    containers.forEach((container) => {
      const cards = container.querySelectorAll('.stacked-card');
      const dots = container.querySelectorAll('.dot-btn');
      const prevBtn = container.querySelector('.prev-btn');
      const nextBtn = container.querySelector('.next-btn');

      if (!cards.length) return;

      let activeIndex = 0;
      const total = cards.length;
      let timer: number | null = null;

      function updateStack() {
        cards.forEach((card, index) => {
          // Calculate relative position to active index
          const offset = (index - activeIndex + total) % total;
          const htmlCard = card as HTMLElement;

          if (offset === 0) {
            // Front active card
            htmlCard.style.zIndex = '30';
            htmlCard.style.opacity = '1';
            htmlCard.style.transform = 'translate(0px, 0px) scale(1) rotate(0deg)';
            htmlCard.style.pointerEvents = 'auto';
          } else if (offset === 1) {
            // 2nd card in stack
            htmlCard.style.zIndex = '20';
            htmlCard.style.opacity = '0.75';
            htmlCard.style.transform = 'translate(14px, -12px) scale(0.95) rotate(3deg)';
            htmlCard.style.pointerEvents = 'none';
          } else if (offset === 2) {
            // 3rd card in stack
            htmlCard.style.zIndex = '10';
            htmlCard.style.opacity = '0.45';
            htmlCard.style.transform = 'translate(-14px, -22px) scale(0.9) rotate(-3deg)';
            htmlCard.style.pointerEvents = 'none';
          } else {
            // Hidden cards behind stack
            htmlCard.style.zIndex = '0';
            htmlCard.style.opacity = '0';
            htmlCard.style.transform = 'translate(0px, 0px) scale(0.85) rotate(0deg)';
            htmlCard.style.pointerEvents = 'none';
          }
        });

        // Update dot indicators
        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.className = 'dot-btn w-8 h-2.5 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(212,175,55,0.8)] transition-all duration-300';
          } else {
            dot.className = 'dot-btn w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300';
          }
        });
      }

      function nextSlide() {
        activeIndex = (activeIndex + 1) % total;
        updateStack();
      }

      function prevSlide() {
        activeIndex = (activeIndex - 1 + total) % total;
        updateStack();
      }

      function startTimer() {
        stopTimer();
        timer = window.setInterval(nextSlide, 3500);
      }

      function stopTimer() {
        if (timer) clearInterval(timer);
      }

      // Event Listeners
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          activeIndex = idx;
          updateStack();
          startTimer();
        });
      });

      cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          if (idx !== activeIndex) {
            activeIndex = idx;
            updateStack();
            startTimer();
          }
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startTimer();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startTimer();
        });
      }

      container.addEventListener('mouseenter', stopTimer);
      container.addEventListener('mouseleave', startTimer);

      // Initial state
      updateStack();
      startTimer();
    });
  }

  // Run on page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStackedCarousels);
  } else {
    initStackedCarousels();
  }
  document.addEventListener('astro:page-load', initStackedCarousels);
</script>
