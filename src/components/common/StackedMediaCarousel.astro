---
import { CheckCircle2, ChevronLeft, ChevronRight, Play } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const items = [
  {
    type: 'video',
    title: 'Container Loading in Action',
    sub: 'Live Factory Container Loading for Global Export',
    src: '/videos/new_assets/kingcoco-video-02.mp4',
    alt: 'Container Loading Video'
  },
  {
    type: 'image',
    title: 'Foil-Wrapped Pallet Export',
    sub: 'Moisture-Proof Shrink Wrap for Ocean Freight',
    src: '/images/new_assets/loading-foil-wrapped-pallets.webp',
    alt: 'Foil Wrapped Pallets Loading'
  },
  {
    type: 'image',
    title: '40ft HC Container Packing',
    sub: 'Maximized Loadability & Secure Palletization',
    src: '/images/new_assets/container-loaded-pallets.webp',
    alt: 'Container Loaded Pallets'
  },
  {
    type: 'image',
    title: 'Global Ocean Shipping',
    sub: 'Worldwide Port Logistics & Customs Compliance',
    src: '/images/new_assets/loading-shipping-container.webp',
    alt: 'Loading Shipping Container'
  },
  {
    type: 'image',
    title: 'Pallet Inspection & Sealing',
    sub: '100% Quality Checked Before Port Dispatch',
    src: '/images/new_assets/wrapping-charcoal-pallet.webp',
    alt: 'Wrapping Charcoal Pallet'
  }
];
---

<div class={`stacked-media-container relative w-full max-w-[540px] mx-auto group select-none ${className}`}>
  <!-- Outer Glow Backdrop -->
  <div class="absolute -inset-4 bg-gradient-to-r from-accent-gold/20 via-primary-green/25 to-accent-gold/20 rounded-3xl transform rotate-2 group-hover:rotate-4 transition-transform duration-700 blur-xl opacity-70"></div>

  <!-- Stack Container -->
  <div class="relative w-full aspect-square max-h-[480px]">
    {items.map((item, index) => (
      <div
        data-index={index}
        class="stacked-media-card absolute inset-0 w-full h-full rounded-3xl p-2 sm:p-3 bg-surface-dark/95 border border-accent-gold/20 shadow-2xl transition-all duration-700 ease-in-out cursor-pointer overflow-hidden"
      >
        <div class="relative w-full h-full rounded-2xl overflow-hidden bg-primary-charcoal">
          {item.type === 'video' ? (
            <video
              src={item.src}
              autoplay
              loop
              muted
              playsinline
              class="video-element w-full h-full object-cover object-bottom"
            ></video>
          ) : (
            <img
              src={item.src}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              class="w-full h-full object-cover object-bottom transition-transform duration-700 group-hover:scale-105"
            />
          )}

          {item.type === 'video' && (
            <div class="absolute top-4 right-4 z-20 px-3 py-1 rounded-full bg-accent-gold/90 backdrop-blur-md text-primary-dark font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-md">
              <Play class="w-3.5 h-3.5 fill-current" /> Live Video
            </div>
          )}

          <!-- Top-Left Title Badge (Leaves bottom watermark 100% clear) -->
          <div class="absolute top-4 left-4 z-20 max-w-[75%] pointer-events-none">
            <span class="inline-block px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-primary-charcoal/90 backdrop-blur-md border border-accent-gold/40 text-accent-gold font-bold text-xs tracking-wider uppercase shadow-lg mb-1">
              {item.title}
            </span>
            <p class="text-xs sm:text-sm text-gray-200 font-medium truncate drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">
              {item.sub}
            </p>
          </div>
        </div>
      </div>
    ))}

    <!-- Floating Order Verification Badge (Positioned top-right outside stack to keep bottom watermark completely clear) -->
    <div class="absolute -top-5 -right-3 sm:-top-6 sm:-right-6 z-40 bg-surface-dark/95 backdrop-blur-md border border-accent-gold/30 p-3.5 sm:p-4 rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.8)] animate-bounce-slow">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 sm:w-11 sm:h-11 bg-gradient-gold text-primary-dark rounded-full flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(212,175,55,0.4)]">
          <CheckCircle2 class="text-primary-dark w-5 h-5 sm:w-6 sm:h-6" />
        </div>
        <div>
          <div class="text-lg sm:text-xl font-bold text-white">40+</div>
          <div class="text-xs text-gray-300 font-medium">Containers Shipped / Mo</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Controls & Dots -->
  <div class="flex items-center justify-between mt-8 px-2 relative z-40">
    <div class="flex items-center gap-2 dots-media-container">
      {items.map((_, i) => (
        <button
          data-dot={i}
          aria-label={`Go to slide ${i + 1}`}
          class={`dot-media-btn w-2.5 h-2.5 rounded-full transition-all duration-300 ${
            i === 0 ? 'bg-accent-gold w-8 shadow-[0_0_10px_rgba(212,175,55,0.8)]' : 'bg-white/20 hover:bg-white/40'
          }`}
        ></button>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        class="prev-media-btn p-2 rounded-full bg-surface-dark/80 backdrop-blur-md border border-white/10 text-white hover:border-accent-gold hover:text-accent-gold transition-colors"
        aria-label="Previous image"
      >
        <ChevronLeft class="w-5 h-5" />
      </button>
      <button
        class="next-media-btn p-2 rounded-full bg-surface-dark/80 backdrop-blur-md border border-white/10 text-white hover:border-accent-gold hover:text-accent-gold transition-colors"
        aria-label="Next image"
      >
        <ChevronRight class="w-5 h-5" />
      </button>
    </div>
  </div>
</div>

<script>
  function initStackedMediaCarousels() {
    const containers = document.querySelectorAll('.stacked-media-container');

    containers.forEach((container) => {
      const cards = container.querySelectorAll('.stacked-media-card');
      const dots = container.querySelectorAll('.dot-media-btn');
      const prevBtn = container.querySelector('.prev-media-btn');
      const nextBtn = container.querySelector('.next-media-btn');

      if (!cards.length) return;

      let activeIndex = 0;
      const total = cards.length;
      let timer: number | null = null;

      function updateStack() {
        cards.forEach((card, index) => {
          const offset = (index - activeIndex + total) % total;
          const htmlCard = card as HTMLElement;
          const videoEl = htmlCard.querySelector('video') as HTMLVideoElement | null;

          if (offset === 0) {
            // Front active
            htmlCard.style.zIndex = '30';
            htmlCard.style.opacity = '1';
            htmlCard.style.transform = 'translate(0px, 0px) scale(1) rotate(0deg)';
            htmlCard.style.pointerEvents = 'auto';

            if (videoEl) {
              videoEl.play().catch(() => {});
            }
          } else if (offset === 1) {
            // 2nd card
            htmlCard.style.zIndex = '20';
            htmlCard.style.opacity = '0.75';
            htmlCard.style.transform = 'translate(14px, -12px) scale(0.95) rotate(3deg)';
            htmlCard.style.pointerEvents = 'none';

            if (videoEl) videoEl.pause();
          } else if (offset === 2) {
            // 3rd card
            htmlCard.style.zIndex = '10';
            htmlCard.style.opacity = '0.45';
            htmlCard.style.transform = 'translate(-14px, -22px) scale(0.9) rotate(-3deg)';
            htmlCard.style.pointerEvents = 'none';

            if (videoEl) videoEl.pause();
          } else {
            // Hidden
            htmlCard.style.zIndex = '0';
            htmlCard.style.opacity = '0';
            htmlCard.style.transform = 'translate(0px, 0px) scale(0.85) rotate(0deg)';
            htmlCard.style.pointerEvents = 'none';

            if (videoEl) videoEl.pause();
          }
        });

        // Update dots
        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.className = 'dot-media-btn w-8 h-2.5 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(212,175,55,0.8)] transition-all duration-300';
          } else {
            dot.className = 'dot-media-btn w-2.5 h-2.5 rounded-full bg-white/20 hover:bg-white/40 transition-all duration-300';
          }
        });
      }

      function nextSlide() {
        activeIndex = (activeIndex + 1) % total;
        updateStack();
      }

      function prevSlide() {
        activeIndex = (activeIndex - 1 + total) % total;
        updateStack();
      }

      function startTimer() {
        stopTimer();
        timer = window.setInterval(nextSlide, 4000);
      }

      function stopTimer() {
        if (timer) clearInterval(timer);
      }

      // Event Listeners
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          activeIndex = idx;
          updateStack();
          startTimer();
        });
      });

      cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          if (idx !== activeIndex) {
            activeIndex = idx;
            updateStack();
            startTimer();
          }
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startTimer();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startTimer();
        });
      }

      container.addEventListener('mouseenter', stopTimer);
      container.addEventListener('mouseleave', startTimer);

      // Initial state
      updateStack();
      startTimer();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStackedMediaCarousels);
  } else {
    initStackedMediaCarousels();
  }
  document.addEventListener('astro:page-load', initStackedMediaCarousels);
</script>
