---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { Instagram, Linkedin, MapPin, Mail, Phone } from 'lucide-astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="bg-primary-charcoal pt-24 pb-12 border-t border-white/10 text-white relative overflow-hidden">
    <!-- Subtle glow in background -->
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent-gold/5 rounded-full blur-[100px] -z-0"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-16">
            <!-- Brand -->
            <div class="lg:col-span-1">
                <a href={translatePath('/')} class="inline-block mb-8">
                    <!-- Added brightness-0 invert to make logo pure white on dark bg -->
                    <img src="/images/logo-king-coco.svg" alt="King Coco Logo" class="h-16 w-auto brightness-0 invert opacity-90 hover:opacity-100 transition-transform transform scale-[1.35] origin-left" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                    <span class="text-2xl font-heading font-bold text-white tracking-tight" style="display: none;">KING<span class="text-accent-gold">COCO</span></span>
                </a>
                <p class="text-gray-400 text-sm leading-relaxed mb-8">
                    {t('about.desc')}
                </p>
                <!-- Social Links -->
                <div class="flex gap-4">
                    <a href="#" aria-label="LinkedIn" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-accent-gold hover:border-accent-gold hover:-translate-y-1 transition-all duration-300 text-gray-400 hover:text-white shadow-lg">
                        <Linkedin class="w-4 h-4" />
                    </a>
                    <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-accent-gold hover:border-accent-gold hover:-translate-y-1 transition-all duration-300 text-gray-400 hover:text-white shadow-lg">
                        <Instagram class="w-4 h-4" />
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h3 class="text-sm font-bold mb-6 text-white tracking-widest uppercase">Quick Links</h3>
                <ul class="space-y-4">
                    <li><a href={translatePath('/#about')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>{t('nav.about')}</a></li>
                    <li><a href={translatePath('/#products')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>{t('nav.products')}</a></li>
                    <li><a href={translatePath('/#gallery')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>{t('nav.gallery')}</a></li>
                    <li><a href={translatePath('/#faq')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>{t('nav.faq')}</a></li>
                </ul>
            </div>

            <!-- Products -->
            <div>
                <h3 class="text-sm font-bold mb-6 text-white tracking-widest uppercase">Our Products</h3>
                <ul class="space-y-4">
                    <li><a href={translatePath('/products/cocopeat/')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>Premium Cocopeat</a></li>
                    <li><a href={translatePath('/products/shisha-charcoal/')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>Coconut Shisha Charcoal</a></li>
                    <li><a href={translatePath('/products/coconut-fiber/')} class="text-gray-400 hover:text-accent-gold transition-colors text-sm flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-accent-gold/0 group-hover:bg-accent-gold transition-colors"></span>Coconut Fiber</a></li>
                </ul>
            </div>

            <!-- Contact Info -->
            <div>
                <h3 class="text-sm font-bold mb-6 text-white tracking-widest uppercase">{t('nav.contact')}</h3>
                <ul class="space-y-5">
                    <li class="flex items-start gap-4 text-sm text-gray-400">
                        <MapPin class="w-5 h-5 text-accent-gold shrink-0 mt-0.5" />
                        <a href="https://maps.app.goo.gl/TJqCo2i7k3uESQDk9" target="_blank" rel="noopener noreferrer" class="leading-relaxed hover:text-accent-gold transition-colors">Yogyakarta, Indonesia<br />(Factory)</a>
                    </li>
                    <li class="flex items-center gap-4 text-sm text-gray-400">
                        <Mail class="w-5 h-5 text-accent-gold shrink-0" />
                        <a href="mailto:export@kingcoco.com" class="hover:text-accent-gold transition-colors">export@kingcoco.com</a>
                    </li>
                    <li class="flex items-center gap-4 text-sm text-gray-400">
                        <Phone class="w-5 h-5 text-accent-gold shrink-0" />
                        <a href="tel:+6283879099434" class="hover:text-accent-gold transition-colors">+62 838 7909 9434</a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Copyright & Bottom Links -->
        <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-gray-400 text-sm">
                &copy; {new Date().getFullYear()} King Coco Indonesia. All rights reserved.
            </p>
            <div class="flex gap-6">
                <a href="#" class="text-gray-400 hover:text-white text-sm transition-colors">Privacy Policy</a>
                <a href="#" class="text-gray-400 hover:text-white text-sm transition-colors">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
