---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = "King Coco | Premium Cocopeat & Coconut Charcoal Exporter", description = "Indonesia's leading supplier of premium B2B Cocopeat and Coconut Charcoal Briquettes." } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/images/logo-king-coco.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased min-h-screen flex flex-col">
		<slot />
		<FloatingWhatsApp />
	</body>
</html>
