---
import '../styles/global.css';
import { getLangFromUrl, languages } from '../i18n/utils';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
	type?: string;
	schema?: string;
}

const { 
	title = "King Cocondo | Premium Cocopeat & Coconut Charcoal Exporter", 
	description = "Premium cocopeat and coconut charcoal products from Indonesia for global B2B buyers. OEM, bulk supply, and export-ready solutions.",
	keywords = "",
	image = "/images/logo-king-cocondo.webp",
	type = "website",
	schema
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/images/logo-king-cocondo.webp" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		
		{schema && <script type="application/ld+json" set:html={schema}></script>}
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Multilingual hreflang -->
		{Object.keys(languages).map((l) => {
			const path = Astro.url.pathname.replace(`/${lang}`, `/${l}`);
			return <link rel="alternate" hreflang={l} href={new URL(path, Astro.site)} />
		})}
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : lang === 'ar' ? 'ar_AR' : 'en_US'} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.site)} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" />
		</noscript>
	</head>
	<body class="antialiased min-h-screen flex flex-col">
		<slot />
		<FloatingWhatsApp />
	</body>
</html>
