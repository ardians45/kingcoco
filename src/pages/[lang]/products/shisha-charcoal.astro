---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import Button from '../../../components/common/Button.astro';
import { CheckCircle2, ChevronRight } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, languages } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const translatePath = useTranslatedPath(lang as keyof typeof languages);
const schema = JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "Coconut Shisha Charcoal Manufacturer Indonesia — Premium Hookah Briquettes",
  "image": "https://kingcoco.com/images/charcoal/briquette.png",
  "description": "100% natural coconut shell charcoal for Shisha/Hookah and BBQ. We are a trusted coconut shisha charcoal exporter and wholesale supplier in Indonesia.",
  "brand": {
    "@type": "Brand",
    "name": "King Coco"
  }
});
---

<Layout 
	title="Coconut Shisha Charcoal Manufacturer Indonesia | King Coco" 
	description={t('seo.char.h1.sub')}
	keywords="coconut shisha charcoal manufacturer indonesia, coconut shisha charcoal exporter indonesia, coconut charcoal briquettes supplier indonesia, coconut charcoal briquettes manufacturer indonesia, coconut shisha charcoal wholesale"
	schema={schema}
>
	<Header />

	<main class="flex-grow pt-20">
		<div class="pt-16 pb-16 bg-bg-light">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<!-- Breadcrumb -->
				<nav class="flex mb-8 text-sm" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 md:space-x-3">
						<li class="inline-flex items-center">
							<a href={translatePath('/')} class="text-gray-500 hover:text-primary-green transition-colors">{t('nav.home')}</a>
						</li>
						<li>
							<div class="flex items-center">
								<ChevronRight class="w-4 h-4 text-gray-400 mx-1" />
								<span class="text-gray-900 font-medium">{t('prod.cat.charcoal')}</span>
							</div>
						</li>
					</ol>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
					<!-- Image Gallery -->
					<div class="space-y-4">
						<div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-white shadow-lg border border-gray-100">
							<img src="/images/charcoal/briquette.png" alt={t('seo.char.h1')} class="w-full h-full object-cover" />
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
								<img src="/images/charcoal/shisha.png" alt="Shisha Charcoal" class="w-full h-full object-cover" />
							</div>
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
								<img src="/images/charcoal/bbq.png" alt="BBQ Charcoal" class="w-full h-full object-cover" />
							</div>
						</div>
					</div>

					<!-- Product Info -->
					<div>
						<span class="inline-block px-4 py-1.5 rounded-full bg-accent-gold/10 text-accent-gold font-semibold text-sm mb-6">
							{t('prod.cat.charcoal')}
						</span>
						
						<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-primary-charcoal mb-6 leading-tight">
							{t('seo.char.h1')}
						</h1>
						
						<p class="text-lg text-text-muted mb-8 leading-relaxed">
							{t('seo.char.h1.sub')}
						</p>

						<!-- Specifications -->
						<h2 class="text-2xl font-bold text-primary-charcoal mb-4">{t('seo.char.spec')}</h2>
						<div class="overflow-x-auto bg-white rounded-xl border border-gray-100 shadow-sm mb-8">
							<table class="w-full text-sm text-left">
								<thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
									<tr>
										<th scope="col" class="px-6 py-4">No</th>
										<th scope="col" class="px-6 py-4">Product</th>
										<th scope="col" class="px-6 py-4">Description</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-100">
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-medium text-gray-900">1</td>
										<td class="px-6 py-4 font-semibold text-primary-charcoal">Shisha Charcoal Briquette</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Ash Content:</strong> &gt; 3%</li>
												<li><strong>Ash Color:</strong> Natural White</li>
												<li><strong>Burning Time:</strong> &gt; 2 hours*</li>
												<li><strong>Fixed Carbon:</strong> ≤ 75%</li>
												<li><strong>Moisture:</strong> 7% Max</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-medium text-gray-900">2</td>
										<td class="px-6 py-4 font-semibold text-primary-charcoal">Shisha Charcoal Briquette</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Ash Content:</strong> 2.5% - 3%</li>
												<li><strong>Ash Color:</strong> Natural White</li>
												<li><strong>Burning Time:</strong> &gt; 2 hours*</li>
												<li><strong>Fixed Carbon:</strong> &gt; 75%</li>
												<li><strong>Moisture:</strong> 6% Max</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-medium text-gray-900">3</td>
										<td class="px-6 py-4 font-semibold text-primary-charcoal">Shisha Charcoal Briquette</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Ash Content:</strong> 2.0-2.5%</li>
												<li><strong>Ash Color:</strong> Natural White</li>
												<li><strong>Burning Time:</strong> &gt; 2 hours*</li>
												<li><strong>Fixed Carbon:</strong> ≤ 80%</li>
												<li><strong>Moisture:</strong> 5% Max</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-medium text-gray-900">4</td>
										<td class="px-6 py-4 font-semibold text-primary-charcoal">Shisha Charcoal Briquette</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Ash Content:</strong> 2% Max</li>
												<li><strong>Ash Color:</strong> Natural White</li>
												<li><strong>Burning Time:</strong> &gt; 2 hours*</li>
												<li><strong>Fixed Carbon:</strong> ≥ 80%</li>
												<li><strong>Moisture:</strong> 5% Max</li>
											</ul>
										</td>
									</tr>
								</tbody>
							</table>
							<div class="p-4 bg-gray-50 text-xs text-gray-500 border-t border-gray-100">
								* standard 25mm cube shape
							</div>
						</div>

						<!-- Applications & Packaging -->
						<div class="space-y-6 mb-10">
							<div>
								<h2 class="text-xl font-bold text-primary-charcoal mb-2">{t('seo.char.app')}</h2>
								<p class="text-text-muted">{t('seo.char.app.desc')}</p>
							</div>
							<div>
								<h2 class="text-xl font-bold text-primary-charcoal mb-4">{t('seo.char.pack')}</h2>
								<ul class="space-y-2 text-text-muted">
									<li class="flex items-center"><CheckCircle2 class="w-4 h-4 text-accent-gold mr-2" /> Full Packaging + Full Color Master Box</li>
									<li class="flex items-center"><CheckCircle2 class="w-4 h-4 text-accent-gold mr-2" /> Full Packaging + Brown Master Box</li>
									<li class="flex items-center"><CheckCircle2 class="w-4 h-4 text-accent-gold mr-2" /> Master Box + Inner Plastics</li>
									<li class="flex items-center"><CheckCircle2 class="w-4 h-4 text-accent-gold mr-2" /> Master Box + Single Plastic (Bulk)</li>
									<li class="flex items-center"><CheckCircle2 class="w-4 h-4 text-accent-gold mr-2" /> Plastics sacks (25kg)</li>
								</ul>
							</div>
						</div>

						<!-- Actions -->
						<div class="flex flex-col sm:flex-row gap-4">
							<Button href={translatePath('/#contact')} variant="primary" class="flex-1 justify-center py-4 text-lg shadow-lg shadow-accent-gold/20 bg-accent-gold hover:bg-yellow-600 border-none">
								{t('seo.char.cta')}
							</Button>
							<Button href={translatePath('/#contact')} variant="outline" class="flex-1 justify-center py-4 text-lg border-2 border-accent-gold text-accent-gold hover:bg-accent-gold hover:text-white">
								{t('contact.wa')}
							</Button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
