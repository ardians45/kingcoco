---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import Button from '../../../components/common/Button.astro';
import { CheckCircle2, ChevronRight } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, languages } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const translatePath = useTranslatedPath(lang as keyof typeof languages);
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "High Quality Coconut Coir Fiber — King Cocondo",
      "image": "https://kingcocondo.com/images/cocopeat/image.webp",
      "description": "Golden yellow brownish coconut coir fiber from Indonesia. High tensile strength, low moisture (<20%), tightly baled for industrial mattress, rope, and upholstery manufacturing.",
      "brand": {
        "@type": "Brand",
        "name": "King Cocondo"
      },
      "category": "Industrial Raw Material / Coir Fiber",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "King Cocondo"
        }
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the primary industrial applications of Coconut Coir Fiber?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coconut coir fiber is widely used for manufacturing eco-friendly mattresses, car seats, door mats, erosion control blankets (geotextiles), ropes, and livestock bedding."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard bale weight and loadability of Coconut Fiber?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard bales weigh 105 - 110 kg each. A 40ft High Cube container loads up to 18 Metric Tons (approx 160-170 bales)."
          }
        }
      ]
    }
  ]
});
---

<Layout 
	title="High Quality Coconut Coir Fiber Supplier & Exporter | King Cocondo" 
	description="Leading supplier of golden coconut coir fiber (105-110kg bales, 10-15cm length) & baby fiber for livestock bedding from Indonesia. High tensile strength."
	keywords="Coconut Fiber, Coco Fiber, Coir Fiber, Coconut Coir, Fiber Supplier, Mattress Fiber, 110kg Baled Coconut Coir Fiber Exporter, 10-15cm Golden Coir Fiber Supplier Indonesia, Baby Fiber High EC for Livestock Bedding, Low Moisture Coconut Coir Fiber Wholesale"
	schema={schema}
>
	<Header />

	<main class="flex-grow pt-20">
		<div class="pt-16 pb-16 bg-bg-light">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<!-- Breadcrumb -->
				<nav class="flex mb-8 text-sm" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 md:space-x-3">
						<li class="inline-flex items-center">
							<a href={translatePath('/')} class="text-gray-500 hover:text-primary-green transition-colors">{t('nav.home')}</a>
						</li>
						<li>
							<div class="flex items-center">
								<ChevronRight class="w-4 h-4 text-gray-400 mx-1" />
								<span class="text-gray-900 font-medium">Coconut Fiber</span>
							</div>
						</li>
					</ol>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
					<!-- Image Gallery -->
					<div class="space-y-4">
						<div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-white shadow-lg border border-gray-100 flex items-center justify-center bg-gray-50">
							<!-- Placeholder as user didn't provide explicit fiber image yet -->
							<img src="/images/cocopeat/image.webp" width="720" height="520" alt={t('seo.fiber.h1')} class="w-full h-full object-cover opacity-80" />
							<div class="absolute inset-0 flex items-center justify-center">
                                <span class="bg-black/50 text-white px-4 py-2 rounded">Coconut Fiber (Baby Fiber)</span>
                            </div>
						</div>
					</div>

					<!-- Product Info -->
					<div>
						<span class="inline-block px-4 py-1.5 rounded-full bg-primary-green/10 text-primary-green font-semibold text-sm mb-6">
							Industrial Materials
						</span>
						
						<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-primary-charcoal mb-6 leading-tight">
							{t('seo.fiber.h1')}
						</h1>
						
						<p class="text-lg text-text-muted mb-8 leading-relaxed">
							{t('seo.fiber.h1.sub')}
						</p>

						<!-- Specifications -->
						<h2 class="text-2xl font-bold text-primary-charcoal mb-4">{t('seo.fiber.spec')}</h2>
						<div class="overflow-x-auto bg-white rounded-xl border border-gray-100 shadow-sm mb-8">
							<table class="w-full text-sm text-left">
								<thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
									<tr>
										<th scope="col" class="px-6 py-4">Product Name</th>
										<th scope="col" class="px-6 py-4 min-w-[300px]">Specifications</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-100">
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Baby Fiber High EC (Livestock Bedding)</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Weight:</strong> +- 250 Kg/Bale</li>
												<li><strong>Moisture:</strong> 40-50%</li>
												<li><strong>Packing:</strong> Jumbo bag</li>
												<li><strong>Loadability:</strong> 80 bales / 40ft HC</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Coconut Fiber</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>Color:</strong> Yellow Brownish</li>
												<li><strong>Fiber Length:</strong> 10-15 cm</li>
												<li><strong>Moisture Content:</strong> &lt; 20%</li>
												<li><strong>Ash Content:</strong> &lt; 5%</li>
												<li><strong>Bale Weight:</strong> 105-110 kg</li>
												<li><strong>Loadability:</strong> 18 MT / 40ft HC</li>
											</ul>
										</td>
									</tr>
								</tbody>
							</table>
						</div>

						<!-- Frequently Asked Questions (FAQ) Section for B2B Buyers -->
						<div class="mt-12 mb-10 pt-8 border-t border-gray-200">
							<h2 class="text-2xl font-bold text-primary-charcoal mb-6">Frequently Asked Questions (FAQ) — Coconut Fiber Supply</h2>
							<div class="space-y-4">
								<div class="p-5 bg-white rounded-xl border border-gray-100 shadow-sm">
									<h3 class="font-bold text-gray-900 text-base mb-2">What are the main specifications of your Baled Coconut Fiber?</h3>
									<p class="text-sm text-gray-600 leading-relaxed">Our golden coir fiber features 10-15cm average fiber length, low moisture content (&lt;20%), low impurity ash (&lt;5%), and high tensile strength for industrial processing.</p>
								</div>
								<div class="p-5 bg-white rounded-xl border border-gray-100 shadow-sm">
									<h3 class="font-bold text-gray-900 text-base mb-2">What is the container loading capacity for Coconut Fiber bales?</h3>
									<p class="text-sm text-gray-600 leading-relaxed">A standard 40ft High Cube container carries approximately 18 Metric Tons of tightly strapped 105-110kg bales.</p>
								</div>
							</div>
						</div>

						<!-- Actions -->
						<div class="flex flex-col sm:flex-row gap-4 mt-10">
							<Button href={translatePath('/#contact')} variant="primary" class="flex-1 justify-center py-4 text-lg shadow-lg shadow-primary-green/20">
								{t('seo.fiber.cta')}
							</Button>
							<Button href={translatePath('/#contact')} variant="outline" class="flex-1 justify-center py-4 text-lg border-2 border-primary-green text-primary-green hover:bg-primary-green hover:text-white">
								{t('contact.wa')}
							</Button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
