---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import Button from '../../../components/common/Button.astro';
import { CheckCircle2, ChevronRight } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, languages } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const translatePath = useTranslatedPath(lang as keyof typeof languages);
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "5kg Low EC Cocopeat Block Substrate — King Cocondo",
      "image": "https://kingcocondo.com/images/new_assets/cocopeat-block.webp",
      "description": "Premium 5kg Low EC washed cocopeat blocks for hydroponics, horticulture, and commercial nurseries. Trusted bulk cocopeat supplier & exporter from Indonesia.",
      "brand": {
        "@type": "Brand",
        "name": "King Cocondo"
      },
      "category": "Organic Growing Medium / Coco Coir Substrate",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "King Cocondo"
        }
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between Low EC and High EC Cocopeat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Low EC cocopeat (<0.6 mS/cm) is thoroughly washed with fresh water to remove excess sodium and potassium, making it ideal for direct plant rooting and hydroponics. High EC cocopeat is unwashed and commonly used for animal bedding."
          }
        },
        {
          "@type": "Question",
          "name": "What is the expansion volume of a 5kg Cocopeat block?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our premium 5kg Low EC blocks expand to 60 - 65 liters of organic substrate when hydrated with water."
          }
        },
        {
          "@type": "Question",
          "name": "How many 5kg cocopeat blocks fit in a 40ft High Cube container?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 40ft HC container can hold up to 4,600 blocks (approx 22 - 24 Metric Tons) stacked on palletized shrink wrap."
          }
        }
      ]
    }
  ]
});
---

<Layout 
	title="Bulk Cocopeat Block Exporter & Supplier Indonesia | King Cocondo" 
	description="Leading exporter of 5kg Low EC washed cocopeat blocks (<0.6 mS/cm, 60L expansion) & 30kg polybags from Indonesia. 4,600 blocks/40ft HC loadability."
	keywords="Cocopeat, Cocopeat Block, Coco Coir, Cocopeat Exporter, Cocopeat Supplier, Hydroponic Substrate, 5kg Low EC Cocopeat Block 60 Liters, 0.6 mS/cm Washed Cocopeat Block Supplier, 4600 Blocks 40ft Container Cocopeat Exporter, 30kg Polybag Cocopeat Low EC Wholesale, Buffered Cocopeat Blocks for Hydroponic Nursery"
	schema={schema}
>
	<Header />

	<main class="flex-grow pt-20">
		<div class="pt-16 pb-16 bg-bg-light">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<!-- Breadcrumb -->
				<nav class="flex mb-8 text-sm" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 md:space-x-3">
						<li class="inline-flex items-center">
							<a href={translatePath('/')} class="text-gray-400 hover:text-accent-gold transition-colors">{t('nav.home')}</a>
						</li>
						<li>
							<div class="flex items-center">
								<ChevronRight class="w-4 h-4 text-gray-400 mx-1" />
								<span class="text-white font-medium">{t('prod.cat.cocopeat')}</span>
							</div>
						</li>
					</ol>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
					<!-- Image Gallery -->
					<div class="space-y-4">
						<div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 shadow-[0_0_15px_rgba(212,175,55,0.1)] border border-surface-dark">
							<img src="/images/new_assets/cocopeat-block.webp" width="720" height="296" alt={t('seo.coco.h1')} class="w-full h-full object-cover object-bottom" />
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 shadow-sm border border-surface-dark">
								<img src="/images/new_assets/raw-coconut-fiber.webp" width="720" height="520" alt={t('prod.coco.block.low')} class="w-full h-full object-cover object-bottom" />
							</div>
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 shadow-sm border border-surface-dark">
								<img src="/images/new_assets/warehouse-cocopeat-blocks.webp" width="720" height="316" alt={t('seo.coco.pack')} class="w-full h-full object-cover object-bottom" />
							</div>
						</div>
					</div>

					<!-- Product Info -->
					<div>
						<span class="inline-block px-4 py-1.5 rounded-full bg-gradient-gold text-primary-dark/10 text-accent-gold font-semibold text-sm mb-6">
							{t('prod.cat.cocopeat')}
						</span>
						
						<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white mb-6 leading-tight">
							{t('seo.coco.h1')}
						</h1>
						
						<p class="text-lg text-text-muted mb-8 leading-relaxed">
							{t('seo.coco.h1.sub')}
						</p>

						<!-- Specifications -->
						<h2 class="text-2xl font-bold text-white mb-4">{t('seo.coco.spec')}</h2>
						<div class="overflow-x-auto bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 rounded-xl border border-surface-dark shadow-sm mb-8">
							<table class="w-full text-sm text-left">
								<thead class="text-xs text-gray-300 uppercase bg-primary-dark border-b border-surface-dark">
									<tr>
										<th scope="col" class="px-6 py-4">Product Name</th>
										<th scope="col" class="px-6 py-4 min-w-[300px]">Specifications</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-100">
									<tr class="hover:bg-primary-dark/50">
										<td class="px-6 py-4 font-semibold text-accent-gold align-top">Cocopeat Block - Low EC (Premium Horticultural)</td>
										<td class="px-6 py-4 text-gray-400">
											<ul class="space-y-1">
												<li><strong>Electrical Conductivity (EC):</strong> &lt; 0.5 dS/m</li>
												<li><strong>Weight:</strong> 5 Kg</li>
												<li><strong>Expansion Volume:</strong> 70 - 80 L</li>
												<li><strong>Moisture:</strong> 20 &plusmn; 5%</li>
												<li><strong>Fiber / Impurities:</strong> Max. 2.0%</li>
												<li><strong>pH:</strong> 5.5 - 7.0</li>
												<li><strong>Dimensions:</strong> 30 &times; 30 &times; 15 &plusmn; 3 cm</li>
												<li><strong>Loadability (40FT HC):</strong> 22 pallets / approx. 4,200 blocks / 21 MT</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-primary-dark/50">
										<td class="px-6 py-4 font-semibold text-accent-gold align-top">Cocopeat Block - Standard / High EC</td>
										<td class="px-6 py-4 text-gray-400">
											<ul class="space-y-1">
												<li><strong>Electrical Conductivity (EC):</strong> &lt; 1000 &micro;S/cm</li>
												<li><strong>Weight:</strong> 5 Kg</li>
												<li><strong>Expansion Volume:</strong> 70 - 80 L</li>
												<li><strong>Moisture:</strong> 20 &plusmn; 5%</li>
												<li><strong>Fiber / Impurities:</strong> Max. 2.0%</li>
												<li><strong>pH:</strong> 5.5 - 7.0</li>
												<li><strong>Dimensions:</strong> 30 &times; 30 &times; 15 &plusmn; 3 cm</li>
												<li><strong>Loadability (40FT HC):</strong> 22 pallets / approx. 4,200 blocks / 21 MT</li>
											</ul>
										</td>
									</tr>
								</tbody>
							</table>
						</div>

						<!-- Applications & Packaging -->
						<div class="space-y-6 mb-10">
							<div>
								<h2 class="text-xl font-bold text-white mb-2">{t('seo.coco.app')}</h2>
								<p class="text-text-muted">{t('seo.coco.app.desc')}</p>
							</div>
						</div>

						<!-- Frequently Asked Questions (FAQ) Section for B2B Buyers -->
						<div class="mt-12 mb-10 pt-8 border-t border-accent-gold/10">
							<h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions (FAQ) — Cocopeat Wholesale & Export</h2>
							<div class="space-y-4">
								<div class="p-5 bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 rounded-xl border border-surface-dark shadow-sm">
									<h3 class="font-bold text-white text-base mb-2">What is the difference between Low EC and High EC Cocopeat?</h3>
									<p class="text-sm text-gray-400 leading-relaxed">Low EC cocopeat (&lt;0.6 mS/cm) is thoroughly washed with fresh water to remove salts, making it optimal for direct seed germination, hydroponics, and greenhouses. High EC is unwashed and used for animal bedding.</p>
								</div>
								<div class="p-5 bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 rounded-xl border border-surface-dark shadow-sm">
									<h3 class="font-bold text-white text-base mb-2">What is the expansion ratio of 5kg cocopeat blocks?</h3>
									<p class="text-sm text-gray-400 leading-relaxed">Each 5kg block expands to approximately 60 to 65 liters of fluffy organic substrate upon hydration.</p>
								</div>
								<div class="p-5 bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 rounded-xl border border-surface-dark shadow-sm">
									<h3 class="font-bold text-white text-base mb-2">How are cocopeat blocks packaged for international container shipping?</h3>
									<p class="text-sm text-gray-400 leading-relaxed">Blocks are individually shrink-wrapped or naked-packed on wooden pallets with protective corner boards and stretch wrapping (4,600 blocks per 40ft HC container).</p>
								</div>
							</div>
						</div>

						<!-- Actions -->
						<div class="flex flex-col sm:flex-row gap-4">
							<Button href={translatePath('/#contact')} variant="primary" class="flex-1 justify-center py-4 text-lg shadow-[0_0_15px_rgba(212,175,55,0.1)] shadow-primary-green/20">
								{t('seo.coco.cta')}
							</Button>
							<Button href={`https://wa.me/6285719619013?text=${encodeURIComponent(t('wa.template'))}`} target="_blank" rel="noopener noreferrer" variant="outline" class="flex-1 justify-center py-4 text-lg border-2 border-primary-green text-accent-gold hover:bg-gradient-gold text-primary-dark hover:text-white">
								{t('contact.wa')}
							</Button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
