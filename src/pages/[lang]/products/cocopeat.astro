---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import Button from '../../../components/common/Button.astro';
import { CheckCircle2, ChevronRight } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, languages } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const translatePath = useTranslatedPath(lang as keyof typeof languages);
const schema = JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "Cocopeat Supplier Indonesia — Low EC Block Exporter for Global Markets",
  "image": "https://kingcocondo.com/images/cocopeat/image%20copy%204.png",
  "description": "Premium washed and buffered cocopeat blocks. As a leading cocopeat exporter in Indonesia, we supply bulk low EC cocopeat blocks for hydroponics, nurseries, and greenhouses.",
  "brand": {
    "@type": "Brand",
    "name": "King Cocondo"
  }
});
---

<Layout 
	title="Cocopeat Supplier Indonesia — Low EC Block Exporter | King Cocondo" 
	description={t('seo.coco.h1.sub')}
	keywords="cocopeat supplier indonesia, cocopeat exporter indonesia, cocopeat block supplier indonesia, low EC cocopeat supplier indonesia"
	schema={schema}
>
	<Header />

	<main class="flex-grow pt-20">
		<div class="pt-16 pb-16 bg-bg-light">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<!-- Breadcrumb -->
				<nav class="flex mb-8 text-sm" aria-label="Breadcrumb">
					<ol class="inline-flex items-center space-x-1 md:space-x-3">
						<li class="inline-flex items-center">
							<a href={translatePath('/')} class="text-gray-500 hover:text-primary-green transition-colors">{t('nav.home')}</a>
						</li>
						<li>
							<div class="flex items-center">
								<ChevronRight class="w-4 h-4 text-gray-400 mx-1" />
								<span class="text-gray-900 font-medium">{t('prod.cat.cocopeat')}</span>
							</div>
						</li>
					</ol>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
					<!-- Image Gallery -->
					<div class="space-y-4">
						<div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-white shadow-lg border border-gray-100">
							<img src="/images/cocopeat/image copy 4.webp" width="720" height="296" alt={t('seo.coco.h1')} class="w-full h-full object-cover" />
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
								<img src="/images/cocopeat/image.webp" width="720" height="520" alt="Cocopeat Block" class="w-full h-full object-cover" />
							</div>
							<div class="aspect-w-4 aspect-h-3 rounded-xl overflow-hidden bg-white shadow-sm border border-gray-100">
								<img src="/images/cocopeat/image copy 5.webp" width="720" height="316" alt="Cocopeat Packaging" class="w-full h-full object-cover" />
							</div>
						</div>
					</div>

					<!-- Product Info -->
					<div>
						<span class="inline-block px-4 py-1.5 rounded-full bg-primary-green/10 text-primary-green font-semibold text-sm mb-6">
							{t('prod.cat.cocopeat')}
						</span>
						
						<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-primary-charcoal mb-6 leading-tight">
							{t('seo.coco.h1')}
						</h1>
						
						<p class="text-lg text-text-muted mb-8 leading-relaxed">
							{t('seo.coco.h1.sub')}
						</p>

						<!-- Specifications -->
						<h2 class="text-2xl font-bold text-primary-charcoal mb-4">{t('seo.coco.spec')}</h2>
						<div class="overflow-x-auto bg-white rounded-xl border border-gray-100 shadow-sm mb-8">
							<table class="w-full text-sm text-left">
								<thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
									<tr>
										<th scope="col" class="px-6 py-4">Product Name</th>
										<th scope="col" class="px-6 py-4 min-w-[300px]">Specifications</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-100">
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Cocopeat Block Low EC Grade A</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>EC:</strong> Max 0.6 mS/cm (1:3)</li>
												<li><strong>Weight:</strong> 4.5 - 5 Kg</li>
												<li><strong>Expansion Volume:</strong> 60 - 65 L / block</li>
												<li><strong>Moisture:</strong> &lt; 20%</li>
												<li><strong>pH:</strong> 5 - 7</li>
												<li><strong>Dimension:</strong> 30x30x12-15 cm</li>
												<li><strong>Packing:</strong> Shrink in pallet</li>
												<li><strong>Loadability:</strong> 4600 blocks / 40ft HC</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Cocopeat Block Low EC Grade B</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>EC:</strong> Max 0.6 mS/cm (1:3)</li>
												<li><strong>Weight:</strong> 4.5 - 5 Kg</li>
												<li><strong>Expansion Volume:</strong> 55 - 60 L / block</li>
												<li><strong>Moisture:</strong> &lt; 20%</li>
												<li><strong>pH:</strong> 5 - 7</li>
												<li><strong>Mesh:</strong> &gt; 1 mm</li>
												<li><strong>Dimension:</strong> 30x30x12-15 cm</li>
												<li><strong>Packing:</strong> Shrink in pallet</li>
												<li><strong>Loadability:</strong> 4600 blocks / 40ft HC</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Cocopeat Block High EC</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>EC:</strong> &gt; 1 mS/cm (1:3)</li>
												<li><strong>Weight:</strong> 4.5 - 5 Kg</li>
												<li><strong>Expansion Volume:</strong> 55 - 60 L / block</li>
												<li><strong>Moisture:</strong> &lt; 20%</li>
												<li><strong>pH:</strong> 5 - 7</li>
												<li><strong>Dimension:</strong> 30x30x12-15 cm</li>
												<li><strong>Loadability:</strong> 4600 blocks / 40ft HC</li>
											</ul>
										</td>
									</tr>
									<tr class="hover:bg-gray-50/50">
										<td class="px-6 py-4 font-semibold text-primary-green align-top">Cocopeat Polybag Low EC</td>
										<td class="px-6 py-4 text-gray-600">
											<ul class="space-y-1">
												<li><strong>EC:</strong> Max 0.5 ms/cm (ratio 1:3)</li>
												<li><strong>Weight per bag:</strong> 29 - 30 kgs</li>
												<li><strong>Moisture:</strong> 40% - 50%</li>
												<li><strong>pH:</strong> 5 - 7</li>
												<li><strong>Mesh:</strong> 4 mm</li>
												<li><strong>Dimension:</strong> 30x40x70 cm</li>
												<li><strong>Packing:</strong> Polybag packaging</li>
												<li><strong>Loadability:</strong> 750 - 800 polybags / 40ft HC</li>
											</ul>
										</td>
									</tr>
								</tbody>
							</table>
						</div>

						<!-- Applications & Packaging -->
						<div class="space-y-6 mb-10">
							<div>
								<h2 class="text-xl font-bold text-primary-charcoal mb-2">{t('seo.coco.app')}</h2>
								<p class="text-text-muted">{t('seo.coco.app.desc')}</p>
							</div>
						</div>

						<!-- Actions -->
						<div class="flex flex-col sm:flex-row gap-4">
							<Button href={translatePath('/#contact')} variant="primary" class="flex-1 justify-center py-4 text-lg shadow-lg shadow-primary-green/20">
								{t('seo.coco.cta')}
							</Button>
							<Button href={translatePath('/#contact')} variant="outline" class="flex-1 justify-center py-4 text-lg border-2 border-primary-green text-primary-green hover:bg-primary-green hover:text-white">
								{t('contact.wa')}
							</Button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
