---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import Button from '../../components/common/Button.astro';
import { CheckCircle2, Factory, PackageCheck, Ship, Globe } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, languages } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const waText = lang === 'id' 
	? "Halo King Cocondo, saya tertarik untuk mendiskusikan kebutuhan produk kelapa premium." 
	: "Hello King Cocondo, I am interested in discussing premium coconut products.";
const waLink = `https://wa.me/6285719619013?text=${encodeURIComponent(waText)}`;
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "King Cocondo",
  "url": "https://kingcocondo.com",
  "logo": "https://kingcocondo.com/images/logo-king-cocondo.webp",
  "description": "Leading coconut shisha charcoal supplier indonesia and exporter of premium Cocopeat and Briquettes.",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+6285719619013",
    "contactType": "sales",
    "email": "ahmad@kingcocondo.com",
    "areaServed": "Worldwide"
  }
});
---

<Layout 
	title={t('seo.home.title') || "Coconut Shisha Charcoal Supplier Indonesia | King Cocondo"}
	description={t('seo.home.desc') || "We are the leading coconut shisha charcoal supplier indonesia and exporter of premium Cocopeat and Briquettes. High-quality, sustainable, and ready for global shipment."}
	keywords={t('seo.home.keywords') || "coconut shisha charcoal supplier indonesia, coconut products exporter indonesia, wholesale cocopeat"}
	schema={schema}
>
	<Header />

	<main class="flex-grow">
		<!-- HERO SECTION -->
		<section class="relative min-h-[90vh] flex items-center pt-20 overflow-visible bg-primary-charcoal pb-32">
			<div class="absolute inset-0 z-0">
				<!-- Desktop Hero Image -->
				<img loading="eager" decoding="async" src="/images/new_assets/hero.webp" width="2752" height="1536" alt="Premium Coconut Products" class="hidden md:block w-full h-full object-cover object-bottom opacity-60" />
				<!-- Mobile Hero Image (Portrait) -->
				<img loading="eager" decoding="async" src="/images/new_assets/hero-mobile.webp" width="1536" height="2752" alt="Premium Coconut Products Mobile" class="block md:hidden w-full h-full object-cover object-bottom opacity-75" />
				<!-- Modern dark gradient with a hint of green, adjusted for better image visibility -->
				<div class="absolute inset-0 bg-gradient-to-tr from-primary-charcoal/90 via-primary-charcoal/60 to-primary-green/40 pointer-events-none"></div>
			</div>
			
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pt-16 pb-12">
				<div class="max-w-3xl">
					<div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 border border-white/10 backdrop-blur-md mb-8 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 transition-colors shadow-[0_0_25px_rgba(212,175,55,0.15)]">
						<span class="w-2.5 h-2.5 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(212,154,55,0.8)] animate-pulse"></span>
						<span class="text-sm font-semibold text-gray-200 tracking-wide uppercase">{t('hero.badge')}</span>
					</div>
					
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-white leading-tight mb-6 drop-shadow-2xl">
						{t('hero.title.1')}
					</h1>
					
					<p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl leading-relaxed text-shadow-sm font-light">
						{t('hero.desc')}
					</p>
					
					<div class="flex flex-col sm:flex-row gap-5">
						<Button href={translatePath('/#contact')} variant="primary" class="py-4 px-10 text-lg w-full sm:w-auto justify-center shadow-[0_0_20px_rgba(27,59,43,0.5)] hover:shadow-[0_0_30px_rgba(27,59,43,0.8)] transition-all hover:-translate-y-1">
							{t('btn.quote')}
						</Button>
						<Button href={translatePath('/#products')} variant="outline" class="py-4 px-10 text-lg w-full sm:w-auto justify-center bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/15 text-white border-white/20 backdrop-blur-sm transition-all hover:-translate-y-1">
							{t('btn.explore')}
						</Button>
					</div>
				</div>
			</div>


		</section>

<!-- ABOUT SECTION -->
		<section id="about" class="pt-40 pb-24 bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 relative overflow-hidden">
			<!-- Decorative background elements -->
			<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-gold text-primary-dark/5 rounded-full blur-3xl -z-10 translate-x-1/3 -translate-y-1/3"></div>
			<div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-accent-gold/5 rounded-full blur-3xl -z-10 -translate-x-1/3 translate-y-1/3"></div>

			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="relative group">
						<!-- Animated backdrop for image -->
						<div class="absolute -inset-4 bg-gradient-to-r from-accent-gold/20 to-primary-green/20 rounded-3xl transform rotate-3 group-hover:rotate-6 transition-transform duration-500"></div>
						<div class="absolute -inset-4 bg-gradient-to-l from-accent-gold/20 to-primary-green/20 rounded-3xl transform -rotate-3 group-hover:-rotate-6 transition-transform duration-500 opacity-50"></div>
						
						<img loading="lazy" decoding="async" src="/images/new_assets/burning-cube-briquettes.webp" width="768" height="1024" alt="Burning Cube Briquettes - King Cocondo" class="relative rounded-3xl shadow-2xl object-contain w-full h-auto max-h-[500px] transition-transform duration-500 group-hover:scale-[1.02] bg-surface-dark/80 p-2 border border-accent-gold/20" />
						
						<!-- Floating badge -->
						<div class="absolute -bottom-6 -right-6 bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 p-6 rounded-2xl shadow-[0_0_25px_rgba(212,175,55,0.15)] hidden sm:block border border-surface-dark animate-bounce-slow">
							<div class="flex items-center gap-4">
								<div class="w-12 h-12 bg-gradient-gold text-primary-dark/10 rounded-full flex items-center justify-center">
									<CheckCircle2 class="text-accent-gold w-6 h-6" />
								</div>
								<div>
									<div class="text-2xl font-bold text-white">100%</div>
									<div class="text-sm text-text-muted">Premium Quality</div>
								</div>
							</div>
						</div>
					</div>
					<div>
						<h2 class="text-accent-gold font-semibold tracking-wider uppercase text-sm mb-3 flex items-center gap-2">
							<span class="w-8 h-px bg-gradient-gold text-primary-dark"></span>
							{t('about.subtitle')}
						</h2>
						<h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white mb-6 leading-tight">{t('about.h2')}</h2>
						<h3 class="text-xl md:text-2xl font-bold text-accent-gold mb-4">{t('about.h3')}</h3>
						<p class="text-text-muted mb-8 text-lg leading-relaxed">
							{t('about.desc')}
						</p>
						<ul class="space-y-5 mb-10">
							<li class="flex items-center gap-4 text-white font-medium bg-primary-dark/50 p-3 rounded-xl border border-surface-dark/50 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 hover:shadow-md transition-all">
								<div class="bg-accent-gold/20 p-2 rounded-lg">
									<CheckCircle2 class="text-accent-gold w-5 h-5 shrink-0" />
								</div>
								<span>{t('about.point1')}</span>
							</li>
							<li class="flex items-center gap-4 text-white font-medium bg-primary-dark/50 p-3 rounded-xl border border-surface-dark/50 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 hover:shadow-md transition-all">
								<div class="bg-accent-gold/20 p-2 rounded-lg">
									<CheckCircle2 class="text-accent-gold w-5 h-5 shrink-0" />
								</div>
								<span>{t('about.point2')}</span>
							</li>
							<li class="flex items-center gap-4 text-white font-medium bg-primary-dark/50 p-3 rounded-xl border border-surface-dark/50 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10 hover:shadow-md transition-all">
								<div class="bg-accent-gold/20 p-2 rounded-lg">
									<CheckCircle2 class="text-accent-gold w-5 h-5 shrink-0" />
								</div>
								<span>{t('about.point3')}</span>
							</li>
						</ul>
						<Button href={translatePath('/#contact')} variant="primary" class="shadow-[0_0_15px_rgba(212,175,55,0.1)] shadow-primary-green/20 py-4 px-8 group">
							<span class="flex items-center gap-2">
								{t('about.btn')}
								<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</span>
						</Button>
					</div>
				</div>
			</div>
		</section>

<!-- WHY CHOOSE US -->
		<section class="py-32 bg-primary-charcoal relative overflow-hidden">
			<!-- Mesmerizing Animated Glow Background -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
				<div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] rounded-full bg-gradient-gold text-primary-dark/10 blur-[150px]"></div>
				<div class="absolute top-[40%] -right-[10%] w-[50%] h-[50%] rounded-full bg-accent-gold/5 blur-[150px]"></div>
			</div>

			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
				<div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
					<div class="max-w-2xl">
						<h2 class="text-accent-gold font-semibold tracking-widest uppercase text-sm mb-4">{t('why.subtitle') || 'Company Advantages'}</h2>
						<h3 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight">{t('why.h2')}</h3>
					</div>
					<div class="md:text-right hidden md:block">
						<div class="inline-flex items-center justify-center w-20 h-20 rounded-full border border-white/10">
							<svg class="w-8 h-8 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10">
					<!-- Card 1 -->
					<div class="relative group rounded-[2.5rem] bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 backdrop-blur-md border border-white/10 p-10 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 transition-all duration-500 overflow-hidden">
						<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 to-emerald-300 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						<div class="absolute -right-10 -top-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-[50px] group-hover:bg-emerald-500/20 transition-colors duration-500"></div>
						
						<div class="relative z-10 flex flex-col h-full">
							<div class="w-16 h-16 rounded-2xl bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 border border-white/20 flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:scale-110 transition-transform duration-500">
								<PackageCheck class="w-8 h-8 text-emerald-400" />
							</div>
							<h4 class="text-2xl font-bold mb-4 text-white group-hover:text-emerald-400 transition-colors duration-300">{t('why.q.title')}</h4>
							<p class="text-gray-300 text-lg leading-relaxed">{t('why.q.desc')}</p>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="relative group rounded-[2.5rem] bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 backdrop-blur-md border border-white/10 p-10 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 transition-all duration-500 overflow-hidden">
						<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-accent-gold to-yellow-300 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						<div class="absolute -right-10 -top-10 w-40 h-40 bg-accent-gold/10 rounded-full blur-[50px] group-hover:bg-accent-gold/20 transition-colors duration-500"></div>
						
						<div class="relative z-10 flex flex-col h-full">
							<div class="w-16 h-16 rounded-2xl bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 border border-white/20 flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:scale-110 transition-transform duration-500">
								<Factory class="w-8 h-8 text-accent-gold" />
							</div>
							<h4 class="text-2xl font-bold mb-4 text-white group-hover:text-accent-gold transition-colors duration-300">{t('why.c.title')}</h4>
							<p class="text-gray-300 text-lg leading-relaxed">{t('why.c.desc')}</p>
						</div>
					</div>

					<!-- Card 3 -->
					<div class="relative group rounded-[2.5rem] bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 backdrop-blur-md border border-white/10 p-10 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 transition-all duration-500 overflow-hidden">
						<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 to-emerald-300 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						<div class="absolute -bottom-10 -left-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-[50px] group-hover:bg-emerald-500/20 transition-colors duration-500"></div>
						
						<div class="relative z-10 flex flex-col h-full">
							<div class="w-16 h-16 rounded-2xl bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 border border-white/20 flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:scale-110 transition-transform duration-500">
								<Ship class="w-8 h-8 text-emerald-400" />
							</div>
							<h4 class="text-2xl font-bold mb-4 text-white group-hover:text-emerald-400 transition-colors duration-300">{t('why.h3.oem')}</h4>
							<p class="text-gray-300 text-lg leading-relaxed">{t('why.oem.desc')}</p>
						</div>
					</div>

					<!-- Card 4 -->
					<div class="relative group rounded-[2.5rem] bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/5 backdrop-blur-md border border-white/10 p-10 hover:bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 transition-all duration-500 overflow-hidden">
						<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-accent-gold to-yellow-300 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						<div class="absolute -bottom-10 -left-10 w-40 h-40 bg-accent-gold/10 rounded-full blur-[50px] group-hover:bg-accent-gold/20 transition-colors duration-500"></div>
						
						<div class="relative z-10 flex flex-col h-full">
							<div class="w-16 h-16 rounded-2xl bg-surface-dark/50 backdrop-blur-md border border-accent-gold/10/10 border border-white/20 flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(212,175,55,0.1)] group-hover:scale-110 transition-transform duration-500">
								<Globe class="w-8 h-8 text-accent-gold" />
							</div>
							<h4 class="text-2xl font-bold mb-4 text-white group-hover:text-accent-gold transition-colors duration-300">{t('why.export.title') || 'Ready for Export'}</h4>
							<p class="text-gray-300 text-lg leading-relaxed">{t('why.export.desc') || 'Experienced in international shipping, permits, and export documentation.'}</p>
						</div>
					</div>
				</div>
			</div>
		</section>

<!-- PRODUCT SHOWCASE -->
		<section id="products" class="py-32 bg-primary-dark relative">
			<div class="absolute inset-0 bg-[url('/images/gallery/grid-pattern.svg')] opacity-[0.03]"></div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
				
				<div class="text-center max-w-3xl mx-auto mb-20">
					<h2 class="text-accent-gold font-semibold tracking-wider uppercase text-sm mb-3">Premium Collection</h2>
					<h2 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">{t('products.h2')}</h2>
					<p class="text-gray-400 text-lg leading-relaxed">{t('prod.desc')}</p>
				</div>

				<div class="space-y-32">
					
					<!-- Cocopeat Category -->
					<div>
						<div class="flex items-center justify-between mb-12">
							<h3 class="text-3xl md:text-4xl font-heading font-bold text-white">{t('prod.cat.cocopeat')}</h3>
							<div class="h-px bg-gray-200 flex-1 ml-8"></div>
						</div>
						
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
							<!-- Cocopeat Grade A -->
							<div class="bg-surface-dark/60 backdrop-blur-xl border border-accent-gold/15 rounded-3xl overflow-hidden shadow-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.2)] hover:border-accent-gold/40 transition-all duration-500 flex flex-col justify-between group relative">
								<span class="absolute top-3 right-3 z-10 bg-accent-gold/20 backdrop-blur-md text-accent-gold border border-accent-gold/30 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">Grade A</span>
								<div class="relative w-full aspect-[4/3] bg-surface-dark/80 overflow-hidden flex items-center justify-center p-3 border-b border-white/5">
									<img src="/images/new_assets/cocopeat-block.webp" width="554" height="554" alt="Cocopeat Block Low EC Grade A" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 ease-out" loading="lazy" />
								</div>
								<div class="p-6 flex-1 flex flex-col justify-between">
									<div>
										<h4 class="text-lg font-heading font-bold text-white mb-4 leading-tight group-hover:text-accent-gold transition-colors">{t('cocopeat.h4.1')}</h4>
										<ul class="space-y-1.5 text-xs mb-6">
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">EC</span><span class="font-bold text-accent-gold">Max 0.6 mS/cm</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Weight</span><span class="font-medium text-white">4.5 - 5 Kg</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Expansion</span><span class="font-medium text-white">60 - 65 L</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Moisture</span><span class="font-medium text-white">&lt; 20%</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">pH Level</span><span class="font-medium text-white">5 - 7</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Dimension</span><span class="font-mono text-gray-200">30×30×15 cm</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Load (40FT)</span><span class="font-medium text-white">4600 blocks</span></li>
										</ul>
									</div>
									<div class="pt-4 border-t border-white/10">
										<Button href={translatePath('/#contact')} variant="outline" class="w-full justify-center py-2 text-xs">Request Quote</Button>
									</div>
								</div>
							</div>

							<!-- Cocopeat Grade B -->
							<div class="bg-surface-dark/60 backdrop-blur-xl border border-accent-gold/15 rounded-3xl overflow-hidden shadow-xl hover:shadow-[0_0_30px_rgba(212,175,55,0.2)] hover:border-accent-gold/40 transition-all duration-500 flex flex-col justify-between group relative">
								<span class="absolute top-3 right-3 z-10 bg-yellow-500/20 backdrop-blur-md text-yellow-400 border border-yellow-500/30 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">Grade B</span>
								<div class="relative w-full aspect-[4/3] bg-surface-dark/80 overflow-hidden flex items-center justify-center p-3 border-b border-white/5">
									<img src="/images/new_assets/cocopeat-block.webp" width="554" height="554" alt="Cocopeat Block Low EC Grade B" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 ease-out" loading="lazy" />
								</div>
								<div class="p-6 flex-1 flex flex-col justify-between">
									<div>
										<h4 class="text-lg font-heading font-bold text-white mb-4 leading-tight group-hover:text-accent-gold transition-colors">{t('cocopeat.h4.2')}</h4>
										<ul class="space-y-1.5 text-xs mb-6">
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">EC</span><span class="font-bold text-accent-gold">Max 0.6 mS/cm</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Weight</span><span class="font-medium text-white">4.5 - 5 Kg</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Expansion</span><span class="font-medium text-white">55 - 60 L</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Moisture</span><span class="font-medium text-white">&lt; 20%</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">pH Level</span><span class="font-medium text-white">5 - 7</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Dimension</span><span class="font-mono text-gray-200">30×30×15 cm</span></li>
											<li class="flex items-center justify-between py-1 border-b border-white/5"><span class="text-gray-400 font-medium">Load (40FT)</span><span class="font-medium text-white">4600 blocks</span></li>
